# --- Mode ---------------------------------------------------------------
# dry_run     : never send / never save a draft. Just log what would happen.
# draft_only  : append generated reply to the IMAP "Drafts" folder (no SMTP send).
# live        : send replies over SMTP.
MODE=dry_run

# Script downgrades send→draft when suspicious, and false value disables that gate/checking. 
POST_CHECK_ENABLED=true

# --- LLM ----------------------------------------------------------------
# Provider is a config choice (openai | azure_openai | anthropic | google_genai | ollama).
LLM_PROVIDER=openai
LLM_ANALYSIS_MODEL=gpt-4o-mini
LLM_REPLY_MODEL=gpt-4o-mini
# Optional fallback model used when the primary chain fails after retries.
# LLM_REPLY_FALLBACK_MODEL=gpt-4o

# --- Provider keys ------------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=

# --- IMAP ---------------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=app-password
# Folder to monitor for incoming mail. Defaults to "INBOX".
IMAP_MAILBOX=INBOX

# --- SMTP ---------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "starttls" (port 587) or "ssl" (port 465).
SMTP_SECURITY=starttls
SMTP_USER=support@example.com
SMTP_PASSWORD=app-password
# Display name on outgoing mail. Defaults to IMAP_USER.
SMTP_FROM_NAME=ReplyDesk

# --- Polling / workers --------------------------------------------------
POLL_SECONDS=30
WORKERS=4
# Max concurrent LLM calls when processing several mails at once.
MAX_CONCURRENCY=4
# Testing helper: process at most N emails per run (0 = no limit).
# Set MAX_EMAILS=1 to stop after working on a single email; the rest
# stay UNSEEN and are picked up on the next run. CLI override:
#   python -m replydesk once --max-emails 1
MAX_EMAILS=0

# --- Safety knobs (rules + post-check) ---------------------------------
PRODUCTS_FILE=products.yaml
ALLOWED_DOMAINS=example.com
MAX_REPLIES_PER_SENDER=3
MIN_CONFIDENCE=0.7
FUZZY_MATCH_THRESHOLD=80
# Hard cap on email body length sent to the LLM (characters).
MAX_BODY_CHARS=6000

# --- Storage ------------------------------------------------------------
DB_PATH=data/replydesk.db

# --- Observability (optional) ------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=replydesk

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
